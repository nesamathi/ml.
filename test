import { useState } from "react";

function App() {
  const [text, setText] = useState("");

  return (
    <div style={{ padding: "40px", fontFamily: "Arial" }}>
      <h1>Arakoo React + Electron App</h1>

      <input
        value={text}
        onChange={(e) => setText(e.target.value)}
        placeholder="Type something"
        style={{
          padding: "10px",
          width: "300px",
          marginRight: "10px",
        }}
      />

      <button
        style={{
          padding: "10px 20px",
          background: "blue",
          color: "white",
          border: "none",
          borderRadius: "4px",
        }}
        onClick={() => alert("You typed: " + text)}
      >
        Show Text
      </button>
    </div>
  );
}

export default App;
